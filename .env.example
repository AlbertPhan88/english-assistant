TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DAILY_HOUR=6
EVENING_HOUR=19
DAILY_IDIOM_COUNT=30
EVENING_IDIOM_COUNT=15
DB_PATH=data/idioms.db

# Access control. ADMIN_CHAT_ID may run /users, /allow and /block, and is told
# when someone new tries to register. With INVITE_ONLY=1 a new /start registers
# the user but leaves them blocked until the admin allows them.
ADMIN_CHAT_ID=
INVITE_ONLY=1

# Models. Content is learner-facing prose, grader judges production answers,
# bulk is high-volume tagging. See src/config.py for the reasoning.
CONTENT_MODEL=claude-sonnet-5-5
GRADER_MODEL=claude-haiku-4-5
BULK_MODEL=claude-haiku-4-5
